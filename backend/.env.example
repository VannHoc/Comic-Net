# Reference only. Set these in the BACKEND process/NetBeans child Run environment.
# Spring Boot does not load this file automatically. Never put real secrets here.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ComicNetDev
# Operator-only isolated restore drill: RESTORE_VERIFICATION=true with
# DB_NAME=ComicNetRestoreQA_<12 lowercase hex>; local profile; setup, Flyway,
# mail/upload workers disabled; use the matching restored S3 volume on a separate endpoint.
RESTORE_VERIFICATION=false
DB_USER=comicnet_app
DB_PASSWORD=REPLACE_LOCALLY
DB_MIGRATION_USER=comicnet_migrator
DB_MIGRATION_PASSWORD=REPLACE_LOCALLY
SPRING_PROFILES_ACTIVE=local
APP_PORT=8080
JWT_PRIVATE_KEY_PATH=C:/path/to/Comic Net/.local/security/jwt-private.pem
JWT_PUBLIC_KEY_PATH=C:/path/to/Comic Net/.local/security/jwt-public.pem
ACCOUNT_MAIL_KEY_PATH=C:/path/to/Comic Net/.local/security/mail.key
SETUP_ENABLED=false
# SETUP_TOKEN is read only by the explicitly enabled one-time local setup launcher.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=comicnet-dev
S3_CREATE_BUCKET=true
S3_ACCESS_KEY=REPLACE_LOCALLY
S3_SECRET_KEY=REPLACE_LOCALLY
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
